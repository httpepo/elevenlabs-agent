# Nunca preencher as variáveis deste arquivo

APP_MODE=demo

DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

TAVILY_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
LEAD_SESSION_SECRET=

# Painel online: usuário HTTP Basic e senha aleatória com pelo menos 24 caracteres.
PANEL_USERNAME=admin
PANEL_PASSWORD=

AGENDA_BASE_URL=https://api.exemplo.com/agenda
AGENDA_TOKEN=
# Contrato confirmado: Authorization: Bearer <AGENDA_TOKEN>.
# Não adicionar /agenda às rotas; incluir na base somente se fizer parte da URL fornecida.
AGENDA_AUTH_HEADER=Authorization
AGENDA_AUTH_PREFIX=Bearer
